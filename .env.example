# Optional private-beta gate. Leave blank for local development without the access-code screen.
ARC_BETA_PASSWORD=

# Optional Google login through Supabase. Arc only requires login when BOTH values are present.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical app origin used for OAuth redirects when configured.
# Example: https://preview.example.com
NEXT_PUBLIC_APP_URL=
