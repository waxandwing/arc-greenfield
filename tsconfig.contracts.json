{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "tests/generated"
  },
  "exclude": ["src/navigation/deskSliceManifest.ts"],
  "include": [
    "src/calendar/**/*.ts",
    "src/navigation/**/*.ts",
    "src/planning/**/*.ts",
    "src/desk/fitMagnetNoteFont.ts",
    "src/desk/fitMagnetNoteFont.contract.ts",
    "src/desk/deskIdeasEvents.ts",
    "src/desk/deskIdeasEvents.contract.ts",
    "src/desk/deskIdeasTrayPark.ts",
    "src/desk/deskIdeasTrayPark.contract.ts",
    "src/planning/courseMinimizePreferences.contract.ts",
    "src/demo/**/*.ts",
    "src/app/setupSections.ts",
    "src/app/setupSections.contract.ts",
    "tests/calendar.contract.ts"
  ]
}
